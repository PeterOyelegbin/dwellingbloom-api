SECRET_KEY=your_django_secret_key_must_more_than_32_characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=yoru_db_password

# Redis configuration
REDIS_URL="redis://127.0.0.1:6379/1"

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Email configuration
EMAIL_HOST=your_email_host
EMAIL_PORT=your_email_port
EMAIL_FROM_NAME="Dwelling Bloom App Support"
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# YouVerify API configuration for KYC verification
YOUVERIFY_API_URL=https://api.sandbox.youverify.co/v2/api/identity/ng/bvn
YOUVERIFY_API_KEY='your_youverify_api_key'

# Dojah API configuration for KYC verification
DOJAH_API_URL=https://sandbox.dojah.io/api/v1/kyc/bvn
DOJAH_API_KEY='your_dojah_api_key'
DOJAH_APP_ID='your_dojah_app_id'

# Other configurations
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
FRONTEND_URL="http://localhost:3000"
